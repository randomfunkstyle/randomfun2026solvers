#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

solver=
mode=batch
expect=
for arg do
  if [ -n "$expect" ]; then
    case "$expect" in
      solver) solver=$arg ;;
      mode) mode=$arg ;;
    esac
    expect=
    continue
  fi
  case "$arg" in
    --solver)
      expect=solver
      ;;
    --mode)
      expect=mode
      ;;
    --mode=*)
      mode=${arg#--mode=}
      ;;
    --solver=*)
      solver=${arg#--solver=}
      ;;
  esac
done

if [ -n "$expect" ]; then
  echo "missing value for --$expect" >&2
  exit 2
fi

if [ -z "$solver" ]; then
  echo "missing required --solver" >&2
  exit 2
fi

case "$mode" in
  batch | interactive) ;;
  *)
    echo "unknown --mode '$mode'; expected batch or interactive" >&2
    exit 2
    ;;
esac

case "$solver" in
  shell-smoke | bash-*)
    exec "$ROOT_DIR/solvers/bash/solve" "$@"
    ;;
  probe | sudoku | python-*)
    PYTHONPATH="$ROOT_DIR/solvers/python${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
    if command -v uv >/dev/null 2>&1; then
      exec uv run python -m randomfun2026solvers.cli "$@"
    fi
    exec python3 -m randomfun2026solvers.cli "$@"
    ;;
  *)
    echo "unknown solver '$solver'; known solvers: shell-smoke, sudoku, probe" >&2
    exit 2
    ;;
esac
