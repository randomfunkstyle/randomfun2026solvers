      "tags": [
        "compute",
        "queue"
      ]
    },
    {
      "name": "S relay",
      "x": 15,
      "y": 0,
      "w": 5,
      "h": 5,
      "note": "Turnaround for the sequence-number tape; one word per 6-tick lap.",
      "color": "#3b82f6",
      "tags": [
        "ring"
      ]
    },
    {
      "name": "V relay",
      "x": 21,
      "y": 0,
      "w": 5,
      "h": 5,
      "note": "Turnaround for the value tape, rotated in lockstep with the S tape.",
      "color": "#3b82f6",
      "tags": [
        "ring"
      ]
    },
    {
      "name": "INIT",
      "x": 8,
      "y": 16,
      "w": 18,
      "h": 1,
      "note": "Seed the tapes: MARK onto S, a junk word onto V. Falls into SCAN, whose first lap reads MARK back and leaves with the flag clear.",
      "color": "#3b82f6",
      "tags": [
        "block"
      ]
    },
    {
      "name": "ENQUEUE",
      "x": 8,
      "y": 17,
      "w": 18,
      "h": 3,
      "note": "A = seq (d + want); push it to S, read val, push it to V, set the flag. Every packet takes this path, the exact match included.",
      "color": "#3b82f6",
      "tags": [
        "block"
      ]
    },
    {
      "name": "SCAN",
      "x": 17,
      "y": 20,
      "w": 9,
      "h": 7,
      "note": "The hot loop, 18 ticks a slot: r(S), subtract want, and one X splits marker / match / no-match.",
      "color": "#3b82f6",
      "tags": [
        "block"
      ]
    },
    {
      "name": "MAIN",
      "x": 8,
      "y": 29,
      "w": 18,
      "h": 4,
      "note": "r(input), A = seq - want. Negative is the driver's sentinel and halts; the rest folds north into `b ]]]] d`.",
      "color": "#3b82f6",
      "tags": [
        "block"
      ]
    },
    {
      "name": "FAIL",
      "x": 9,
      "y": 24,
      "w": 5,
      "h": 1,
      "note": "d >= 16: emit -1 and stop. The stream is lost.",
      "color": "#3b82f6",
      "tags": [
        "block"
      ]
    },
    {
      "name": "MATCH",
      "x": 8,
      "y": 33,
      "w": 18,
      "h": 3,
      "note": "r(V), emit, want += 1, flag another pass -- the new want may sit in a slot this pass has already walked past.",
      "color": "#3b82f6",
      "tags": [
        "block"
      ]
    }
  ],
